# Copy to .env.local and fill in from your Supabase project settings.

# Project API (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Secret key (Settings -> API). Server-only: used for the dev login bypass.
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

# Postgres connection string (Settings -> Database -> Connection pooling -> Session).
# Used directly by the app for all data queries.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- OAuth (optional) ---------------------------------------------------------
# No env vars needed. To enable "Continue with Google / GitHub" on the sign-in
# screen: in the Supabase dashboard go to Authentication -> Providers, enable the
# provider, and add these to its Redirect URLs:
#   http://localhost:3000/auth/callback
#   https://<your-domain>/auth/callback
# The buttons already POST to /api/auth/oauth?provider=google|github and the
# /auth/callback route finishes the exchange.

# --- Security -----------------------------------------------------------------
# Self-service "Owner" sign-up is a demo convenience. It is ON in development and
# OFF in production unless you set this to "true". Owners can always create more
# Owners from the Team page.
# ALLOW_OWNER_SIGNUP=false
